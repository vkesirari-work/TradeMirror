# Public project configuration only. Never use a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin for email confirmation redirects; no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paid AI is disabled by default for the free-only edition.
# Enable only for a future explicitly authorized paid integration.
TRADEMIRROR_ENABLE_PAID_AI=false
# Optional server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
